{
  "name": "@1pe/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "test": "tsx --test src/*.test.ts",
    "validate:content": "tsx src/validate-content.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@1pe/contracts": "workspace:*",
    "@1pe/core": "workspace:*",
    "fastify": "^5.2.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": { "typescript": "^5.7.2", "tsx": "^4.19.2", "@types/node": "^22.10.2" }
}
